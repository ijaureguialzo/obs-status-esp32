.serena/

# Central version file (read by the firmware and macOS app builds; both
# fall back to 1.0.0 / build 1 when it is absent, e.g. in CI)
/version.txt

# Generated firmware version header: every firmware build path (PlatformIO
# extra script, CMake configure/bootstrap, ninja custom command)
# regenerates it before compiling, so it is safe to ignore.
/esp32-firmware/include/firmware_version_generated.h

# The app used to keep a generated ObsStatusVersion.swift here; the app now
# reads its version from the bundle Info.plist (baked from version.txt by a
# run script), so nothing should live in this folder. It is ignored as a
# guard: a file appearing here would be picked up by the synchronized group
# and clash with Models/ObsStatusVersion.swift.
/macos-app/obs-status-macos-ui/Generated/
