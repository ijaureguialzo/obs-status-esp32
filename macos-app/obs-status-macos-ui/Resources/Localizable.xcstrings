{
  "sourceLanguage": "en",
  "strings": {
    "● RECORDING": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "● GRABANDO"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "● GRABATZEN"
          }
        }
      }
    },
    "Already connected to an ESP32 device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un dispositivo ESP32 conectado"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagoeneko ESP32 gailu bati konektatuta"
          }
        }
      }
    },
    "Applied to the ESP32 while OBS is recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al ESP32 mientras OBS está grabando."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32ari aplikatzen zaio OBS grabatzen ari den bitartean."
          }
        }
      }
    },
