    "OBS is currently recording.\nThe ESP32 LED is ON.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS está grabando.\nEl LED del ESP32 está encendido."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS grabatzen ari da.\nESP32ren LEDa piztuta dago."
          }
        }
      }
    },
    "OBS recording is stopped.\nThe ESP32 LED is OFF.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de OBS está detenida.\nEl LED del ESP32 está apagado."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "OBSren grabaketa geldituta dago.\nESP32ren LEDa itzalita dago."
          }
        }
      }
    },
