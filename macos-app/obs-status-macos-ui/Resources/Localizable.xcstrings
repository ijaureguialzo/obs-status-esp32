      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún dispositivo ESP32 conectado"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez zaude inongo ESP32 gailura konektatuta"
