    },
    "OBS closed the WebSocket connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS cerró la conexión WebSocket"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "OBSek WebSocket konexioa itxi du"
          }
        }
      }
    },
    "OBS Connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión con OBS"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "OBS konexioa"
          }
        }
      }
