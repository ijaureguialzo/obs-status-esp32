    "No device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún dispositivo"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gailurik ez"
          }
        }
      }
    },
    "No devices found. Connect your ESP32 and click Scan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún dispositivo. Conecta tu ESP32 y pulsa Buscar."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez da gailurik aurkitu. Konektatu zure ESP32 eta sakatu Bilatu."
          }
        }
      }
    },
    "Not Connected": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Konektatu gabe"
          }
        }
