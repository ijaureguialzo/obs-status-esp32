      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto por última vez"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azken aldiz ikusia"
          }
        }
