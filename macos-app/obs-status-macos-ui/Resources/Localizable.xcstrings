      }
    },
    "This OBS connection is not encrypted: the token and recording state travel in plaintext. Enable wss if your OBS setup supports it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con OBS no está cifrada: el token y el estado de grabación viajan en texto plano. Activa wss si tu configuración de OBS lo admite."
          }
        }
      }
    },
    "Encrypt connection (wss)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrar conexión (wss)"
          }
        }
      }
    },
    "The ESP32 did not respond (is it powered on and finished booting?)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ESP32 no ha respondido (¿está encendido y ha terminado de arrancar?)"
